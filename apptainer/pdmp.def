Bootstrap: docker
From: condaforge/mambaforge:latest

%labels
    Version 0.1
    Description pdmp Bayesian inference framework with jax-fem

%post
    export DEBIAN_FRONTEND=noninteractive

    # System libraries required by gmsh's bundled binary.
    # Determined via: ldd libgmsh.so | grep -v conda
    # Covers: OpenGL, X11/Xft/Xinerama, freetype, png, brotli, gomp.
    apt-get update -qq && apt-get install -y -qq \
        git \
        libgomp1 \
        libgl1-mesa-glx \
        libglu1-mesa \
        libopengl0 \
        libx11-6 \
        libxext6 \
        libxft2 \
        libxrender1 \
        libxinerama1 \
        libxcursor1 \
        libxrandr2 \
        libxi6 \
        libfontconfig1 \
        libfreetype6 \
        libpng16-16 \
        libbrotli1 \
        && rm -rf /var/lib/apt/lists/*

    # Create conda environment with all heavy (non-pip) dependencies
    mamba create -n pdmp-jax -y \
        -c conda-forge -c defaults \
        python=3.10 \
        "numpy==2.2.6" \
        "scipy==1.15.2" \
        "matplotlib==3.10.3" \
        seaborn \
        "meshio==5.3.5" \
        "petsc4py==3.23.4" \
        "fenics==2019.1.0" \
        tqdm \
        pytest \
        pytest-cov \
        snakeviz \
        gpytorch \
        arviz \
        yapf \
        pyyaml \
        typing-extensions \
        botorch \
        pip

    PDMP_ENV=/opt/conda/envs/pdmp-jax

    # pip-only packages (jax, gmsh, fenics-basix, geomloss)
    $PDMP_ENV/bin/pip install --no-cache-dir \
        jax \
        "setuptools==80.9.0" \
        "wheel==0.45.1" \
        "gmsh==4.14.0" \
        "fenics-basix==0.9.0" \
        "pyfiglet==1.0.3" \
        geomloss

    # Install jax-fem at the commit pinned by the project (c3fbcb3)
    git clone https://github.com/deepmodeling/jax-fem.git /opt/jax-fem
    cd /opt/jax-fem && git checkout c3fbcb3
    $PDMP_ENV/bin/pip install --no-cache-dir /opt/jax-fem
    rm -rf /opt/jax-fem/.git  # drop git history to save space

    # Clean up package caches
    mamba clean --all -y
    $PDMP_ENV/bin/pip cache purge || true

%environment
    export PATH=/opt/conda/envs/pdmp-jax/bin:$PATH
    export CONDA_DEFAULT_ENV=pdmp-jax
    export CONDA_PREFIX=/opt/conda/envs/pdmp-jax
    # pdmp source tree is bind-mounted at /pdmp at runtime (see run.sh)
    export PYTHONPATH=/pdmp${PYTHONPATH:+:$PYTHONPATH}
    # suppress gmsh GUI (headless)
    export DISPLAY=""

%runscript
    exec "$@"
